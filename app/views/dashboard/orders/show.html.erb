<% content_for :title, "Order #{@order.reference}" %>

<%= link_to "&larr; All orders".html_safe, dashboard_orders_path, class: "back-link" %>

<h1>Order <%= @order.reference %></h1>

<div class="card summary-card">
  <div>
    <div class="customer">
      <%= @order.customer_name %> <span class="customer-email">&lt;<%= @order.customer_email %>&gt;</span>
    </div>
  </div>
  <div>
    <span class="amount"><%= money(@order.amount_cents, @order.currency) %></span>
    <%= status_badge(@order.status) %>
  </div>
</div>

<% if @order.pending? || @order.awaiting_payment? %>
  <%= button_to "Initiate Payment",
        dashboard_order_payments_path(@order),
        params: { idempotency_key: @payment_idempotency_key },
        method: :post %>
<% end %>

<h2>Payments</h2>
<% if @payments.empty? %>
  <p class="empty-state">No payments initiated yet.</p>
<% else %>
  <div class="card">
    <table>
      <thead>
        <tr>
          <th>Reference</th>
          <th>Status</th>
          <th>Provider Reference</th>
          <th>Failure Reason</th>
          <th>Initiated</th>
        </tr>
      </thead>
      <tbody>
        <% @payments.each do |payment| %>
          <tr>
            <td><%= payment.reference %></td>
            <td><%= status_badge(payment.status) %></td>
            <td><%= payment.provider_reference || "&mdash;".html_safe %></td>
            <td><%= payment.failure_reason || "&mdash;".html_safe %></td>
            <td><%= payment.created_at.strftime("%b %-d, %Y %H:%M") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<h2>History</h2>
<% if @payment_events.empty? %>
  <p class="empty-state">No status changes yet.</p>
<% else %>
  <ul class="history-list">
    <% @payment_events.each do |event| %>
      <li>
        <%= event.created_at.strftime("%b %-d, %Y %H:%M:%S") %> &mdash;
        payment <%= event.payment.reference %>:
        <%= event.from_status %> &rarr; <%= event.to_status %>
        (via <%= event.source %>)
      </li>
    <% end %>
  </ul>
<% end %>
