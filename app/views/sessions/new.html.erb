<div class="auth-shell">
  <div class="auth-card">
    <h1>Log in</h1>

    <%= form_with url: login_path, method: :post do |form| %>
      <div>
        <%= form.label :email %>
        <%= form.email_field :email, required: true, autofocus: true %>
      </div>

      <div>
        <%= form.label :password %>
        <%= form.password_field :password, required: true %>
      </div>

      <%= form.submit "Log in" %>
    <% end %>

    <div class="demo-hint">
      <strong>Demo credentials</strong>
      <p>
        <span class="demo-hint-value">demo@example.com</span><br>
        <span class="demo-hint-value">password123</span>
      </p>
    </div>

    <div class="demo-hint">
      <strong>New merchant?</strong>
      <p><%= link_to "Create an account", signup_path %></p>
    </div>
  </div>
</div>
